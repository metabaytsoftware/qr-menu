# Production Environment Variables
# This file is for reference - actual variables should be set in:
# - Vercel Dashboard (for Frontend)
# - Cloud Run Service (for Backend)

# ============================================
# VERCEL ENVIRONMENT (apps/web)
# ============================================
NEXT_PUBLIC_BASE_URL=https://qr-menu.fx8.io
NEXT_PUBLIC_API_URL=https://api.qr-menu.fx8.io

# Optional: Supabase Storage (if using for images)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# CLOUD RUN ENVIRONMENT (apps/api)
# ============================================
NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Database (PostgreSQL - Supabase)
# These should be set as Cloud Run Secrets, not visible in code
DATABASE_URL=postgresql://postgres:password@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-secure-32char-string-here
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=generate-secure-32char-string-here
REFRESH_TOKEN_EXPIRY=7d

# Redis (Upstash)
# Format: https://username:password@region.upstash.io
REDIS_URL=https://default:your-password@your-region.upstash.io

# CORS - Only allow production domain
CORS_ORIGIN=https://qr-menu.fx8.io
