# API Server Configuration
NODE_ENV=development
PORT=3002

# ===== DATABASE CONFIGURATION =====
# Local Development (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/qr_menu?schema=public"

# Production (Supabase - pgbouncer connection pooling)
# Replace with your Supabase connection string from https://supabase.co
# PORT 5432 = direct connection (slow when many connections)
# PORT 6543 = pgbouncer pooling (recommended for serverless)
# DATABASE_URL="postgresql://postgres:password@db.supabase.co:6543/postgres"

# ===== JWT AUTHENTICATION =====
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your_secret_key_change_in_production"
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ===== LOGGING =====
# Options: debug, info, warn, error
LOG_LEVEL=debug

# ===== CORS & SECURITY =====
# Allowed origins for frontend requests
CORS_ORIGIN="http://localhost:3003,http://192.168.1.116:3003"

# ===== CLOUD DEPLOYMENT =====
# Google Cloud Run environment (set automatically by Cloud Run)
# K_SERVICE=qr-order-api
# K_REVISION=qr-order-api-00001
# K_CONFIGURATION=qr-order-api
# PORT=8080 (Cloud Run sets this, overrides above)

# ===== OPTIONAL: THIRD-PARTY INTEGRATIONS =====
# Add as needed for future integrations
# STRIPE_API_KEY=sk_test_...
# SENDGRID_API_KEY=SG...
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...

# ===== FEATURE FLAGS =====
# Enable/disable features
FEATURE_ORDERS_ENABLED=true
FEATURE_STATIONS_ENABLED=true
FEATURE_REPORTS_ENABLED=true
