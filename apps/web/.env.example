# QR Order Web - Environment Variables
# Copy this file to .env.local for development or configure via Vercel dashboard for production

# ===== BASE URLS =====
# Application base URL (used for redirects, cookies, etc)
NEXT_PUBLIC_BASE_URL=http://localhost:3003

# API backend URL
# Local development: http://localhost:3002
# Production (Cloud Run - EU): https://qr-order-api-572304365391.europe-west3.run.app
NEXT_PUBLIC_API_URL=https://qr-order-api-572304365391.europe-west3.run.app

# ===== AUTHENTICATION =====
# These can be hardcoded as they're public (frontend-only)
# Actual secrets like JWT_SECRET should be server-only in API

# ===== ANALYTICS & MONITORING =====
# Google Analytics ID (optional)
# NEXT_PUBLIC_GA_ID=

# ===== SENTRY ERROR MONITORING =====
# Public DSN for client-side error tracking (safe to expose)
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN (same value as above, kept server-only)
SENTRY_DSN=
# Source map upload — create at https://sentry.io/settings/auth-tokens/
SENTRY_AUTH_TOKEN=
# Org and project slugs from your Sentry dashboard
SENTRY_ORG=
SENTRY_PROJECT=

# ===== FEATURE FLAGS =====
NEXT_PUBLIC_FEATURE_ADMIN_DASHBOARD=true
NEXT_PUBLIC_FEATURE_QR_DISPLAY=true
NEXT_PUBLIC_FEATURE_STATION_VIEW=true

# ===== DEVELOPMENT =====
# Enable debug logging
NEXT_PUBLIC_DEBUG=false

# ===== NOTES FOR DIFFERENT ENVIRONMENTS =====
#
# DEVELOPMENT (Local)
#   NEXT_PUBLIC_BASE_URL=http://localhost:3003
#   NEXT_PUBLIC_API_URL=http://localhost:3002
#
# PRODUCTION (Vercel + Cloud Run)
#   NEXT_PUBLIC_BASE_URL=https://qr-menu.fx8.io
#   NEXT_PUBLIC_API_URL=https://qr-order-api-572304365391.europe-west3.run.app
#   Set these via Vercel Dashboard → Settings → Environment Variables
#
# STAGING
#   Set via Vercel preview deployments (auto-inherits from prod)
#   Override specific vars if needed via branch deployment config
